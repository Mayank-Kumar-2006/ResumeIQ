# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/resumeiq?retryWrites=true&w=majority

# JWT Configuration
JWT_SECRET=your_super_secret_jwt_key_at_least_32_characters_long
JWT_EXPIRES_IN=7d

# Gemini API (optional - AI features require a valid Gemini API key)
GEMINI_API_KEY=your_gemini_api_key_here

# File Upload
MAX_FILE_SIZE_MB=5
UPLOAD_DIR=uploads

# CORS
CLIENT_URL=http://localhost:5173

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_MAX=10
ANALYSIS_RATE_LIMIT_MAX=20
